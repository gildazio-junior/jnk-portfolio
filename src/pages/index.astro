---
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap hero">
		<h1>Gildázio Santos Junior</h1>
		<span class="eyebrow">Analista DevOps · Observabilidade &amp; Cloud</span>
		<p class="lead">
			Tenho mais de 15 anos de experiência em tecnologia. Comecei na manutenção de computadores, passei
			pela administração de servidores e redes estruturadas e depois pelos sistemas ERP e bancos de dados
			Oracle PL/SQL. Nos últimos anos, tenho me dedicado a DevOps e observabilidade: monitoro serviços
			críticos como pagamentos via Pix, KYC e sistemas transacionais com Datadog, Grafana, Cloudflare e
			CloudWatch, antecipando problemas e entregando dados consistentes para as equipes de engenharia e
			DevOps.
		</p>
		<div class="btns">
			<a class="btn primary" href="/curriculo">Ver currículo</a>
			<a class="btn" href="/projetos">Projetos</a>
			<a class="btn" href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
		</div>
	</div>

	<section class="block">
		<div class="wrap">
			<h2>No que eu trabalho</h2>
			<p class="sub">O dia a dia de quem cuida da saúde de sistemas em produção.</p>
			<div class="grid">
				<div class="card">
					<h3>Observabilidade</h3>
					<p>Dashboards, logs, métricas e alertas que respondem rápido à pergunta "o que está quebrado e por quê".</p>
				</div>
				<div class="card">
					<h3>Monitoramento de negócio</h3>
					<p>Fluxos críticos acompanhados ponta a ponta: pagamentos instantâneos, KYC/liveness e transações.</p>
				</div>
				<div class="card">
					<h3>Resposta a incidentes</h3>
					<p>Atendimento N2 em produção, triagem com o N1 e escalonamento certo para o time certo.</p>
				</div>
				<div class="card">
					<h3>Cloudflare &amp; cloud</h3>
					<p>DNS, CDN, segurança e Workers — este site, aliás, roda na Cloudflare a partir de um repositório no GitHub.</p>
				</div>
			</div>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2>Artigos recentes</h2>
					<p class="sub">Notas sobre ferramentas de observabilidade e como a IA está mudando essa área.</p>
					<div class="grid">
						{posts.map((p) => (
							<a class="card" href={`/blog/${p.id}/`}>
								<div class="meta"><FormattedDate date={p.data.pubDate} /></div>
								<h3>{p.data.title}</h3>
								<p>{p.data.description}</p>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
<style>
	.hero {
		padding-top: 80px;
		padding-bottom: 64px;
	}
	h1 {
		font-size: clamp(30px, 4.8vw, 50px);
		line-height: 1.1;
		margin: 0 0 14px;
		max-width: 22ch;
	}
	.lead {
		font-size: clamp(17px, 2vw, 19px);
		color: var(--muted);
		max-width: 64ch;
		margin: 0 0 28px;
	}
</style>
