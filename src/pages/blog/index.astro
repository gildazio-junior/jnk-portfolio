---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
	title="Artigos"
	description="Artigos sobre Datadog, Grafana, Cloudflare e o uso de IA na observabilidade."
>
	<div class="wrap narrow">
		<div class="page-head">
			<h1>Artigos</h1>
			<p>Notas práticas sobre ferramentas de observabilidade e como a IA está mudando a forma de operar sistemas.</p>
		</div>
		<ul class="posts">
			{
				posts.map((post) => (
					<li>
						<a class="card" href={`/blog/${post.id}/`}>
							<div class="meta">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<div class="tags">
									{post.data.tags.map((t) => (
										<span class="tag">{t}</span>
									))}
								</div>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Base>
<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}
	.posts h2 {
		margin: 4px 0 6px;
		font-size: 21px;
	}
	.posts .tags {
		margin-top: 12px;
	}
</style>
