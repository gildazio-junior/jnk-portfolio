---
import Base from '../layouts/Base.astro';
import { CONTACT, COMPANY } from '../consts';
---

<Base
	title="JNK Tecnologia"
	description="JNK Serviços de Tecnologia — contratação PJ para observabilidade, cloud e Cloudflare."
>
	<div class="wrap">
		<div class="page-head">
			<span class="eyebrow">Contratação PJ</span>
			<h1>JNK Serviços de Tecnologia</h1>
			<p>
				A JNK é a minha empresa para atuar como PJ — em vagas de longo prazo ou em projetos pontuais de
				observabilidade e cloud.
			</p>
		</div>

		<div class="grid">
			<div class="card">
				<h3>Observabilidade</h3>
				<p>Dashboards, alertas e análise de logs com Datadog, Grafana e CloudWatch, inclusive migrações entre ferramentas.</p>
			</div>
			<div class="card">
				<h3>Monitoramento de negócio</h3>
				<p>Visibilidade de fluxos críticos como pagamentos, transações e jornadas de verificação de identidade.</p>
			</div>
			<div class="card">
				<h3>Cloudflare</h3>
				<p>Migração de domínios, DNS, CDN, regras de segurança, Pages e Workers.</p>
			</div>
			<div class="card">
				<h3>ERP &amp; dados</h3>
				<p>Sankhya, Oracle PL/SQL e painéis analíticos com Metabase.</p>
			</div>
		</div>

		<section class="block contact" id="contato">
			<div class="card box">
				<div>
					<h2>Vamos conversar?</h2>
					<p class="sub">Conte o desafio do seu ambiente — respondo pessoalmente.</p>
				</div>
				<div class="btns">
					<a class="btn primary" href={`mailto:${CONTACT.email}?subject=Contato%20pelo%20site`}>{CONTACT.email}</a>
					<a class="btn" href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
				</div>
			</div>
			<p class="meta legal">{COMPANY.name} · CNPJ {COMPANY.cnpj}</p>
		</section>
	</div>
</Base>
<style>
	.contact {
		margin-top: 48px;
	}
	.box {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		align-items: center;
		justify-content: space-between;
		padding: 30px;
	}
	.box h2 {
		margin: 0 0 4px;
	}
	.box .sub {
		margin: 0;
	}
	.legal {
		margin-top: 14px;
	}
</style>
