---
import { CONTACT, COMPANY } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site">
	<div class="wrap">
		<span>© {year} {COMPANY.name} · CNPJ {COMPANY.cnpj}</span>
		<span class="links">
			<a href={`mailto:${CONTACT.email}`}>E-mail</a>
			<a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			<a href={CONTACT.github} target="_blank" rel="noopener">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
		margin-top: 48px;
		padding: 28px 0 44px;
		color: var(--muted);
		font-size: 14px;
	}
	.wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		justify-content: space-between;
	}
	.links {
		display: flex;
		gap: 16px;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
